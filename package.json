    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "bootstrap": "5.3.3",
    "bootstrap-icons": "1.11.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "5.4.14"
  }
}
